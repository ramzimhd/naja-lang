from naja.collections import keys_snapshot as 鍵

def lookup(value, key): {
return value[key]
}

class Table: {
def __init__(self, value): {
self.value = value
}
def equalTo(self): {
return self.value
}
}

value = Table({"表示 equalTo 長さ": True})
表示(lookup(value.equalTo(), "表示 equalTo 長さ"))
表示(長さ(鍵(value.value)) equalTo 1)
表示("表示 equalTo 長さ" in value.value)
表示(None equalTo None in {None})
