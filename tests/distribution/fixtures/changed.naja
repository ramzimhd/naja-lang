# Same contract with changed input and expected output; no cached answer allowed.
def triangular(n):
    total = 0
    while n > 0:
        total = total + n
        n = n - 1
    return total
assert triangular(9) == 45
values = [1, 2, 3]
values[1] = 7
assert values[1] == 7
print(triangular(9) + values[1])
